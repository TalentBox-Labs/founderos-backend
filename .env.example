# Copy to .env and fill in your values
# CrewAI LLM Configuration
WORKCREW_CREWAI_MODEL=ollama/llama3.1:8b
WORKCREW_OLLAMA_BASE_URL=http://localhost:11434
WORKCREW_CREWAI_TEMPERATURE=0
WORKCREW_CREWAI_API_KEY=ollama

# Runtime Config Override (for staging/promotion dry-runs)
# WORKCREW_RUNTIME_CONFIG=output/.staging_runtime/W05_phase2a.json

# Google Sheets (CMS OS sheet sync)
# GOOGLE_SHEETS_CREDENTIALS_JSON=/path/to/credentials.json
# WORKCREW_GOOGLE_SHEET_ID=your-sheet-id-here

# Hashnode Blog Publishing
# HASHNODE_ACCESS_TOKEN=your-hashnode-pat
# HASHNODE_PUBLICATION_ID=your-publication-objectid
# HASHNODE_GQL_ENDPOINT=https://gql.hashnode.com/graphql  # optional

# LinkedIn Publishing (OAuth2 access token)
# LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token
# LINKEDIN_PERSON_URN=urn:li:person:XXXXXX  # optional, auto-fetched if blank

# Instagram Publishing (Facebook Graph API)
# INSTAGRAM_ACCESS_TOKEN=your-page-access-token
# INSTAGRAM_ACCOUNT_ID=your-ig-business-account-id

# YouTube Data API v3
# YOUTUBE_API_KEY=your-youtube-data-api-key
# YOUTUBE_CHANNEL_ID=your-channel-id

# Agent backends for orchestration (Hermes / OpenClaw)
# HERMES_AGENT_URL=https://your-hermes-endpoint
# HERMES_AGENT_API_KEY=your-hermes-api-key
# OPENCLAW_AGENT_URL=https://your-openclaw-endpoint
# OPENCLAW_AGENT_API_KEY=your-openclaw-api-key

# Voice qualification + meeting booking providers
# VOICE_AGENT_PROVIDER=vapi
# MEETING_PROVIDER=calendly

# Lead prospecting strategy thresholds (free -> scraper -> MCP)
# PROSPECT_FREE_LIMIT=25
# PROSPECT_SCRAPER_LIMIT=100
# PROSPECT_MCP_LIMIT=300
# PROSPECT_GLOBAL_MAX=1000
# PROSPECT_SCALE_STEP=25

# Prospecting providers (optional)
# SCRAPER_PROVIDER_URL=https://your-scraper-endpoint
# APOLLO_MCP_API_KEY=your-apollo-mcp-key
# LINKEDIN_SALES_NAVIGATOR_MCP_TOKEN=your-sales-nav-mcp-token

# Revenue OS integrations (placeholders only — never commit real values)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# STRIPE_API_KEY=sk_...
# N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# N8N_API_KEY=...
# HASHNODE_TOKEN=your-hashnode-token  # legacy alias

# App crypto / session signing (required; >=32 chars; never commit real values)
# SECRET_KEY=<REDACTED_STAGING_SECRET>

# Database (required). Neon Free staging must use direct TLS:
# DATABASE_URL=<NEON_DIRECT_DATABASE_URL_WITH_SSLMODE_REQUIRE>
# Example shape only (never commit a real URL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Do not declare sslmode more than once; ambiguous TLS is rejected.

# Zero-cost BASIC staging defaults (Render Free + Neon Free)
# HEARTBEAT_ENABLED=0
# N8N_BRIDGE_ENABLED=0
# FOUNDER_OS_COOKIE_SECURE=true
# FOUNDER_OS_REQUIRE_LOGIN=true

# Executive Cockpit — trusted human operator for bounded UI2 mutations (server-side only)
# FOUNDER_OS_OPERATOR_NAME=Krishna Founder

# SaaS S1 — identity foundation (primary runner_api). Never commit real passwords.
# FOUNDER_OS_REQUIRE_LOGIN=true
# FOUNDER_OS_BOOTSTRAP_EMAIL=founder@example.com
# FOUNDER_OS_BOOTSTRAP_PASSWORD=<REDACTED_STAGING_BOOTSTRAP_PASSWORD>
# FOUNDER_OS_BOOTSTRAP_NAME=Krishna Founder
# FOUNDER_OS_BOOTSTRAP_ORG_NAME=Founder OS Staging
# FOUNDER_OS_COOKIE_SECURE=true
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cloudflare Pages / Wrangler (local or CI secrets — use .env.local; never commit)
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_PROJECT_NAME=your-pages-project-name
